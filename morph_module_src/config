TARGET=ngx_http_morph_module

INCDIRS="$ngx_addon_dir/include /usr/include/glib-2.0 /usr/lib64/glib-2.0/include"
LIBDIRS=

SRCS="$ngx_addon_dir/src/std.cpp \
      $ngx_addon_dir/src/ngx_http_morph_module.cpp"

DEPS="$ngx_addon_dir/include/std.h"

LIBS="-lstdc++ -lvips"

#

ngx_addon_name=$TARGET

if test -n "$ngx_module_link"; then
        ngx_module_type=HTTP
        ngx_module_name=$TARGET
        ngx_module_incs=$INCDIRS
        ngx_module_deps=$DEPS
        ngx_module_srcs=$SRCS
        ngx_module_libs="$LIBS $LIBDIRS"
#       ngx_module_link=YES

        . auto/module
else
        HTTP_MODULES="$HTTP_MODULES $TARGET"
        NGX_ADDON_SRCS="$NGX_ADDON_SRCS $SRCS"

        CORE_INCS="$CORE_INCS $INCDIRS"
        CORE_LIBS="$CORE_LIBS $LIBS $LIBDIRS"
fi
