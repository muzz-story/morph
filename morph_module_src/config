TARGET=ngx_http_morph_module

INCDIRS="$ngx_addon_dir/include /usr/local/include /usr/include /usr/include/glib-2.0 /usr/lib64/glib-2.0/include"
LIBDIRS="-L/usr/local/lib"

SRCS="$ngx_addon_dir/src/ngx_http_morph_module.cpp \
      $ngx_addon_dir/src/ngx_http_morph_image.cpp \
      $ngx_addon_dir/src/ngx_http_morph_reader.cpp \
      $ngx_addon_dir/src/ngx_http_morph_resizer.cpp \
      $ngx_addon_dir/src/ngx_http_morph_filters.cpp \
      $ngx_addon_dir/src/std.cpp"

DEPS="$ngx_addon_dir/include/std.h"

LIBS="-lvips -lstdc++ -lz -lm -lglib-2.0 -lxml2 -lwebp -lwebpdemux -lwebpmux -ljpeg -lpng -lgobject-2.0 -lopenjp2 -lrsvg-2 -ltiff -lgsf-1 -lfftw3 -limagequant -lcairo -llcms2 -lexif -lorc-0.4 -lIlmImf -lcgif -lcurl"

#

ngx_addon_name=$TARGET

if test -n "$ngx_module_link"; then
        ngx_module_type=HTTP
        ngx_module_name=$TARGET
        ngx_module_incs=$INCDIRS
        ngx_module_deps=$DEPS
        ngx_module_srcs=$SRCS
        ngx_module_libs="$LIBS $LIBDIRS"
#       ngx_module_link=YES

        . auto/module
else
        HTTP_MODULES="$HTTP_MODULES $TARGET"
        NGX_ADDON_SRCS="$NGX_ADDON_SRCS $SRCS"

        CORE_INCS="$CORE_INCS $INCDIRS"
        CORE_LIBS="$CORE_LIBS $LIBS $LIBDIRS"
fi
